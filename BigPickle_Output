func _print_selection_counts(category: String) -> void:
	var total: int = 0
	var straight: int = 0
	var circle: int = 0
	var other: int = 0

	for row in _summary_rows:
		if str(row.get("category", "")) != category:
			continue

		total += 1
		match str(row.get("class", "")):
			"STRAIGHT_LOOP":
				straight += 1
			"CIRCLE_STRAFE":
				circle += 1
			_:
				other += 1

	_line(
		category + ": queries=" + str(total)
		+ " | straight_loop=" + str(straight)
		+ " | circle_strafe=" + str(circle)
		+ " | other=" + str(other)
	)


# ============================================================
# SMALL HELPERS
# ============================================================

func _line(text: String = "") -> void:
	print(text)


func _f(value: Variant) -> String:
	return "%.6f" % float(value)


func _v3(value: Variant) -> String:
	if typeof(value) != TYPE_VECTOR3:
		return str(value)

	var vector: Vector3 = value
	return "(%.6f, %.6f, %.6f)" % [vector.x, vector.y, vector.z]


func _v3_array(values: Variant) -> String:
	if typeof(values) != TYPE_ARRAY:
		return str(values)

	var array: Array = values
	var parts: Array[String] = []
	for i in range(array.size()):
		parts.append(_v3(array[i]))
	return "[" + ", ".join(parts) + "]"


func _float_array(values: Variant) -> String:
	if typeof(values) != TYPE_ARRAY:
		return str(values)

	var array: Array = values
	var parts: Array[String] = []
	for i in range(array.size()):
		parts.append(_f(array[i]))
	return "[" + ", ".join(parts) + "]"


func _signed_deg(value: float) -> String:
	if value > 0.0:
		return "+" + _f(value)
	return _f(value)


func _pad(text: String, width: int) -> String:
	if text.length() >= width:
		return text
	return text + " ".repeat(width - text.length())


func _rank_text(rank: int) -> String:
	if rank <= 0:
		return "NOT_TOP_10"
	return "#" + str(rank)


func _is_circle_strafe_name(name: String) -> bool:
	for tracked_name in CIRCLE_STRAFE_NAMES:
		if name == tracked_name:
			return true
	return false


func _classify(name: String) -> String:
	if _is_circle_strafe_name(name) or name.contains("Circle Strafe"):
		return "CIRCLE_STRAFE"

	if name.contains("Loop") and not name.contains("Circle"):
		return "STRAIGHT_LOOP"

	return "OTHER"


func _tracked_ranks(result: Dictionary) -> Dictionary:
	var ranks: Dictionary = {
		"R_189": -1,
		"L_190": -1
	}

	var top: Variant = result.get("top_matches", [])
	if typeof(top) != TYPE_ARRAY:
		return ranks

	var array: Array = top
	for i in range(array.size()):
		if typeof(array[i]) != TYPE_DICTIONARY:
			continue

		var candidate: Dictionary = array[i]
		var name: String = str(candidate.get("animation_name", ""))
		var rank: int = int(candidate.get("rank", i + 1))

		if name == CIRCLE_STRAFE_R:
			ranks["R_189"] = rank
		elif name == CIRCLE_STRAFE_L:
			ranks["L_190"] = rank

	return ranks


func _result_has_tracked_circle(result: Dictionary) -> bool:
	var ranks: Dictionary = _tracked_ranks(result)
	return int(ranks.get("R_189", -1)) > 0 or int(ranks.get("L_190", -1)) > 0


func _changed_text(result: Dictionary, current_index: int) -> String:
	if current_index < 0:
		return "N/A"
	if not bool(result.get("success", false)):
		return "UNKNOWN"
	return "YES" if int(result.get("animation_index", -1)) != current_index else "NO"
