		var candidate: Dictionary = top_array[i]

		_line("")
		_line(
			"#" + str(candidate.get("rank", i + 1))
			+ " | " + str(candidate.get("animation_name", "N/A"))
			+ " | class=" + _classify(str(candidate.get("animation_name", "")))
		)
		_line("  animation_index: " + str(candidate.get("animation_index", -1)))
		_line("  sample_index: " + str(candidate.get("sample_index", -1)))
		_line("  sample time: " + _f(candidate.get("time", -1.0)))
		_line("  duration: " + _f(candidate.get("duration", -1.0)))
		_line("  local velocity: " + _v3(candidate.get("velocity", Vector3.ZERO)))
		_line("  raw velocity: " + _v3(candidate.get("raw_velocity", Vector3.ZERO)))
		_line("  velocity_cost:   " + _f(candidate.get("velocity_cost", -1.0)))
		_line("  trajectory_cost: " + _f(candidate.get("trajectory_cost", -1.0)))
		_line("  facing_cost:     " + _f(candidate.get("facing_cost", -1.0)))
		_line("  rotation_cost:   " + _f(candidate.get("rotation_cost", -1.0)))

		if continuous:
			_line("  base_cost:       " + _f(candidate.get("base_cost", -1.0)))
			_line("  continuity_cost: " + _f(candidate.get("continuity_cost", -1.0)))
