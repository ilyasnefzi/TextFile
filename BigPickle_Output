# ============================================================
# TRAJECTORY / CURVATURE DIAGNOSTIC
# ============================================================
# Independent diagnostic for the existing MotionMatchingSearch GDExtension.
# It does not change the search engine, weights, eligibility rules, database,
# or any existing test/script.
#
# IMPORTANT API NOTE:
# The current C++ search accepts:
#   desired_velocity, desired_future_positions, desired_facing_yaw
# and, for continuous search, continuity parameters.
#
# It does NOT accept desired future yaw deltas. Therefore all circular and
# direction-change queries below supply curved FUTURE POSITIONS only. The
# returned future_yaw_deltas_degrees value is data FROM THE MATCHED SAMPLE,
# not a requested yaw target.

const DATABASE_PATH: String = "user://motion_database.json"

const TEST_SPEED: float = 4.5
const FUTURE_TIMES: Array = [0.2, 0.4, 0.6]
const DESIRED_FACING_YAW: float = 0.0
const TOP_MATCHES_TO_PRINT: int = 10

# Existing runtime continuity parameters from MotionMatching/root_motion_test.gd.
const ANIMATION_SWITCH_PENALTY: float = 0.5
const SAME_ANIMATION_TIME_WEIGHT: float = 0.5

# Direction-change queries begin turning at this time.
const TURN_BEGIN_TIME: float = 0.2

const CIRCLE_STRAFE_R: String = "M Neutral Run Circle Strafe R_fit_Armature_189"
const CIRCLE_STRAFE_L: String = "M Neutral Run Circle Strafe L_fit_Armature_190"
const CIRCLE_STRAFE_NAMES: Array[String] = [
	CIRCLE_STRAFE_R,
	CIRCLE_STRAFE_L
]

var _search: MotionMatchingSearch = null
var _summary_rows: Array[Dictionary] = []

# Captured contexts used to choose "current" animations for continuous tests.
var _straight_context: Dictionary = {}
var _circle_context: Dictionary = {}


# ============================================================
# LIFECYCLE
# ============================================================

func _ready() -> void:
	_print_header()

	_search = MotionMatchingSearch.new()

	var loaded: bool = _search.load_database(DATABASE_PATH)

	_line("---------- DATABASE INITIALIZATION ----------")
	_line("load_database(" + DATABASE_PATH + "): " + str(loaded))

	if not loaded:
		_line("DATABASE LOAD FAILED")
		_line("get_last_error(): " + str(_search.get_last_error()))
		_line("Diagnostic aborted.")
		get_tree().quit(1)
		return

	_line("Animation count: " + str(_search.get_animation_count()))
	_line("Sample count: " + str(_search.get_sample_count()))
	_line("Eligible animation count: " + str(_search.get_eligible_animation_count()))
	_line("Eligible sample count: " + str(_search.get_eligible_sample_count()))

	_run_straight_tests()
	_run_circular_tests()
	_run_direction_change_tests()
	_run_continuous_tests()
	_print_summary()

	_line("")
	_line("DIAGNOSTIC COMPLETE")
	get_tree().quit(0)


# ============================================================
# TEST GROUPS
# ============================================================

func _run_straight_tests() -> void:
	_line("")
	_line("================================================================")
	_line(" GROUP 1 - STRAIGHT LOCOMOTION")
	_line("================================================================")

	var tests: Array = [
		_make_straight_query("STRAIGHT FORWARD", Vector3(0.0, 0.0, 1.0)),
		_make_straight_query("STRAIGHT BACKWARD", Vector3(0.0, 0.0, -1.0)),
		_make_straight_query("STRAIGHT LEFT", Vector3(-1.0, 0.0, 0.0)),
		_make_straight_query("STRAIGHT RIGHT", Vector3(1.0, 0.0, 0.0)),
		_make_straight_query("FORWARD LEFT DIAGONAL", Vector3(-1.0, 0.0, 1.0).normalized()),
		_make_straight_query("FORWARD RIGHT DIAGONAL", Vector3(1.0, 0.0, 1.0).normalized())
	]

	for query in tests:
		var result: Dictionary = _run_basic_query(query, "STRAIGHT")
		if str(query.get("name", "")) == "STRAIGHT FORWARD":
			_straight_context = _make_context_from_result(result, "STRAIGHT FORWARD")


func _run_circular_tests() -> void:
	_line("")
	_line("================================================================")
	_line(" GROUP 2 - CONTINUOUS CIRCULAR LOCOMOTION")
	_line("================================================================")
	_line("API LIMITATION: current search has NO desired-future-yaw-delta argument.")
	_line("These tests use curved FUTURE POSITIONS ONLY.")
	_line("Returned future yaw deltas describe the matched sample; they are not requested values.")

	var angular_velocities: Array = [90.0, -90.0, 180.0, -180.0]

	for omega_deg in angular_velocities:
		var query: Dictionary = _make_circular_query("CIRCLE " + _signed_deg(omega_deg), float(omega_deg))
		var result: Dictionary = _run_basic_query(query, "CIRCULAR")

		if _circle_context.is_empty() and _result_has_tracked_circle(result):
			_circle_context = _make_context_from_result(result, "CIRCLE " + _signed_deg(omega_deg))


func _run_direction_change_tests() -> void:
	_line("")
	_line("================================================================")
	_line(" GROUP 3 - DIRECTION CHANGES WHILE MAINTAINING SPEED")
	_line("================================================================")
	_line("Turn begins after " + _f(TURN_BEGIN_TIME) + " seconds.")
	_line("API LIMITATION: curved FUTURE POSITIONS ONLY; no yaw-rate query is available.")
	_line("Sharper +/-180 deg/s variants are included because the API accepts arbitrary future positions.")

	var tests: Array = [
		_make_direction_change_query("CHANGE FORWARD TO FORWARD LEFT +90", 90.0),
		_make_direction_change_query("CHANGE FORWARD TO FORWARD RIGHT -90", -90.0),
		_make_direction_change_query("SHARP CHANGE FORWARD TO FORWARD LEFT +180", 180.0),
		_make_direction_change_query("SHARP CHANGE FORWARD TO FORWARD RIGHT -180", -180.0)
	]

	for query in tests:
		_run_basic_query(query, "DIRECTION_CHANGE")


func _run_continuous_tests() -> void:
	_line("")
	_line("================================================================")
	_line(" GROUP 4 - CONTINUITY-AWARE SEARCH")
	_line("================================================================")
	_line("Continuity parameters (unchanged from existing runtime):")
	_line("  animation_switch_penalty = " + _f(ANIMATION_SWITCH_PENALTY))
	_line("  same_animation_time_weight = " + _f(SAME_ANIMATION_TIME_WEIGHT))

	var straight_state: Dictionary = _resolve_straight_current_state()
	var circle_state: Dictionary = _resolve_circle_current_state()

	var current_states: Array = [
		{
			"label": "NO_CURRENT_ANIMATION",
			"index": -1,
			"time": 0.0,
			"name": "N/A"
		},
		straight_state,
		circle_state
	]

	var queries: Array = [
		_make_straight_query("CONTINUOUS STRAIGHT FORWARD", Vector3(0.0, 0.0, 1.0)),
		_make_circular_query("CONTINUOUS CIRCLE +90", 90.0),
		_make_circular_query("CONTINUOUS CIRCLE -90", -90.0),
		_make_direction_change_query("CONTINUOUS CHANGE LEFT +90", 90.0),
		_make_direction_change_query("CONTINUOUS CHANGE RIGHT -90", -90.0)
	]

	for state in current_states:
		if int(state.get("index", -1)) < 0 and str(state.get("label", "")) != "NO_CURRENT_ANIMATION":
			_line("")
			_line("SKIPPING current state " + str(state.get("label", "?")) + ": no usable animation index found.")
			continue

		for query in queries:
			_run_continuous_query(query, "CONTINUOUS", state)


