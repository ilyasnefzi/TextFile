func _resolve_straight_current_state() -> Dictionary:
	var result: Dictionary = _straight_context.get("result", {})
	var index: int = _first_non_circle_index(result)

	if index >= 0:
		var name: String = str(_straight_context.get("name", "STRAIGHT LOOP"))
		var time: float = _context_time_for_index(result, index)
		return {
			"label": "CURRENT_STRAIGHT_LOOP",
			"index": index,
			"time": time,
			"name": name
		}

	for candidate_name in ["M Neutral Run Loop F_fit_Armature_114", "M Neutral Run Loop B_fit_Armature_117"]:
		var parsed_index: int = _find_animation_index_by_name(candidate_name)
		if parsed_index >= 0:
			return {
				"label": "CURRENT_STRAIGHT_LOOP",
				"index": parsed_index,
				"time": 0.0,
				"name": candidate_name
			}

	return {
		"label": "CURRENT_STRAIGHT_LOOP",
		"index": -1,
		"time": 0.0,
		"name": "NOT FOUND"
	}


func _resolve_circle_current_state() -> Dictionary:
	var result: Dictionary = _circle_context.get("result", {})
	var index: int = _first_tracked_circle_index(result)

	if index >= 0:
		return {
			"label": "CURRENT_CIRCULAR_LOOP",
			"index": index,
			"time": _context_time_for_index(result, index),
			"name": _name_for_index(result, index)
		}

	for candidate_name in CIRCLE_STRAFE_NAMES:
		var parsed_index: int = _find_animation_index_by_name(candidate_name)
		if parsed_index >= 0:
			return {
				"label": "CURRENT_CIRCULAR_LOOP",
				"index": parsed_index,
				"time": 0.0,
				"name": candidate_name
			}

	return {
		"label": "CURRENT_CIRCULAR_LOOP",
		"index": -1,
		"time": 0.0,
		"name": "NOT FOUND"
	}


func _make_context_from_result(result: Dictionary, label: String) -> Dictionary:
	return {
		"name": label,
		"result": result
	}


func _first_non_circle_index(result: Dictionary) -> int:
	var top: Variant = result.get("top_matches", [])
	if typeof(top) != TYPE_ARRAY:
		return -1

	for i in range(top.size()):
		if typeof(top[i]) != TYPE_DICTIONARY:
			continue
		var name: String = str(top[i].get("animation_name", ""))
		if not _is_circle_strafe_name(name):
			return int(top[i].get("animation_index", -1))

	return int(result.get("animation_index", -1))


func _first_tracked_circle_index(result: Dictionary) -> int:
	var top: Variant = result.get("top_matches", [])
	if typeof(top) != TYPE_ARRAY:
		return -1

	for i in range(top.size()):
		if typeof(top[i]) != TYPE_DICTIONARY:
			continue
		var name: String = str(top[i].get("animation_name", ""))
		if _is_circle_strafe_name(name):
			return int(top[i].get("animation_index", -1))

	return -1


func _context_time_for_index(result: Dictionary, index: int) -> float:
	if int(result.get("animation_index", -1)) == index:
		return float(result.get("time", 0.0))

	var top: Variant = result.get("top_matches", [])
	if typeof(top) == TYPE_ARRAY:
		for i in range(top.size()):
			if typeof(top[i]) == TYPE_DICTIONARY and int(top[i].get("animation_index", -1)) == index:
				return float(top[i].get("time", 0.0))

	return 0.0


func _name_for_index(result: Dictionary, index: int) -> String:
	if int(result.get("animation_index", -1)) == index:
		return str(result.get("animation_name", "N/A"))

	var top: Variant = result.get("top_matches", [])
	if typeof(top) == TYPE_ARRAY:
		for i in range(top.size()):
			if typeof(top[i]) == TYPE_DICTIONARY and int(top[i].get("animation_index", -1)) == index:
				return str(top[i].get("animation_name", "N/A"))

	return "N/A"


# Mirrors the loader's animation indexing rules so names from the JSON map to
# the animation_index values returned by search_best_match().
func _find_animation_index_by_name(target_name: String) -> int:
	if not FileAccess.file_exists(DATABASE_PATH):
		return -1

	var file: FileAccess = FileAccess.open(DATABASE_PATH, FileAccess.READ)
	if file == null:
		return -1

	var text: String = file.get_as_text()
	file.close()

	var json := JSON.new()
	if json.parse(text) != OK:
		return -1

	if typeof(json.data) != TYPE_ARRAY:
		return -1

	var database_index: int = 0
	var animations: Array = json.data

	for i in range(animations.size()):
		if typeof(animations[i]) != TYPE_DICTIONARY:
			continue

		var animation: Dictionary = animations[i]
		var samples_variant: Variant = animation.get("trajectory_samples", [])
		if typeof(samples_variant) != TYPE_ARRAY:
			continue

		var samples: Array = samples_variant
		var has_sample: bool = false
		for j in range(samples.size()):
			if typeof(samples[j]) == TYPE_DICTIONARY:
				has_sample = true
				break

		if not has_sample:
			continue

		if str(animation.get("name", "")) == target_name:
			return database_index

		database_index += 1

	return -1


