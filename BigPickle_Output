# SEARCH EXECUTION
# ============================================================

func _run_basic_query(query: Dictionary, category: String) -> Dictionary:
	_print_query_header(query, category, false, {})

	var result: Dictionary = _search.search_best_match(
		query.get("velocity", Vector3.ZERO),
		query.get("future", []),
		DESIRED_FACING_YAW
	)

	_print_result(result, false, {})
	_add_summary_row(query, category, result, {}, false)
	return result


func _run_continuous_query(query: Dictionary, category: String, state: Dictionary) -> Dictionary:
	_print_query_header(query, category, true, state)

	var result: Dictionary = _search.search_best_match_continuous(
		query.get("velocity", Vector3.ZERO),
		query.get("future", []),
		DESIRED_FACING_YAW,
		int(state.get("index", -1)),
		float(state.get("time", 0.0)),
		ANIMATION_SWITCH_PENALTY,
		SAME_ANIMATION_TIME_WEIGHT
	)

	var context: Dictionary = {
		"current_label": str(state.get("label", "N/A")),
		"current_name": str(state.get("name", "N/A")),
		"current_index": int(state.get("index", -1)),
		"changed": _changed_text(result, int(state.get("index", -1)))
	}

	_print_result(result, true, context)
	_add_summary_row(query, category, result, context, true)
	return result


