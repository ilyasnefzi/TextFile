MotionMatching/movement_intent_controller.gd
extends Node
class_name MovementIntentController

# Input and movement-intent foundation for the Motion Matching runtime.
#
# This node only converts player input into normalized intent vectors:
#   - movement_intent_local: relative to the camera/aim reference frame
#   - movement_intent_world: flattened world-space direction
#
# It does not drive any physics body.

const ACTION_MOVE_FORWARD: StringName = &"move_forward"
const ACTION_MOVE_BACKWARD: StringName = &"move_backward"
const ACTION_MOVE_LEFT: StringName = &"move_left"
const ACTION_MOVE_RIGHT: StringName = &"move_right"
const ACTION_SPRINT: StringName = &"sprint"
const ACTION_COMBAT_MODE: StringName = &"combat_mode"

const REQUIRED_ACTIONS: Array[StringName] = [
	ACTION_MOVE_FORWARD,
	ACTION_MOVE_BACKWARD,
	ACTION_MOVE_LEFT,
	ACTION_MOVE_RIGHT,
	ACTION_SPRINT,
	ACTION_COMBAT_MODE,
]

# Project convention: forward is +Z, right is +X.
const LOCAL_FORWARD: Vector3 = Vector3(0.0, 0.0, 1.0)
const LOCAL_RIGHT: Vector3 = Vector3(1.0, 0.0, 0.0)

const AXIS_EPSILON: float = 0.000001

enum ReferenceForwardAxis {
	POSITIVE_Z, # Aim/character reference whose local +Z is forward.
	NEGATIVE_Z, # Camera3D reference whose local -Z is forward.
}

@export var reference_node: Node3D
@export var reference_forward_axis: ReferenceForwardAxis = ReferenceForwardAxis.NEGATIVE_Z
@export var input_deadzone: float = 0.2
@export var update_in_process: bool = true

var raw_input: Vector2 = Vector2.ZERO
var movement_intent_local: Vector3 = Vector3.ZERO
var movement_intent_world: Vector3 = Vector3.ZERO
var reference_forward_world: Vector3 = LOCAL_FORWARD
var reference_right_world: Vector3 = LOCAL_RIGHT
var has_reference: bool = false
var sprint_pressed: bool = false
var combat_mode_active: bool = false


func _ready() -> void:
	set_process(update_in_process)


func _process(_delta: float) -> void:
	update_movement_intent()


func get_missing_actions() -> Array[StringName]:
	var missing: Array[StringName] = []
	for action: StringName in REQUIRED_ACTIONS:
		if not InputMap.has_action(action):
			missing.append(action)
	return missing


func has_required_actions() -> bool:
	return get_missing_actions().is_empty()


func set_reference(new_reference: Node3D, axis: int = -1) -> void:
	reference_node = new_reference
	if axis >= 0:
		reference_forward_axis = axis
	update_movement_intent()


func clear_reference() -> void:
	reference_node = null
	has_reference = false
	update_movement_intent()


func update_movement_intent() -> void:
	if not has_required_actions():
		_clear_state()
		return

	_read_directional_input()

	movement_intent_local = Vector3(raw_input.x, 0.0, raw_input.y)
	if movement_intent_local.length() > 1.0:
		movement_intent_local = movement_intent_local.normalized()

	_update_reference_axes()

	movement_intent_world = (
		reference_right_world * movement_intent_local.x
		+ reference_forward_world * movement_intent_local.z
	)
	if movement_intent_world.length() > 1.0:
		movement_intent_world = movement_intent_world.normalized()

	sprint_pressed = Input.is_action_pressed(ACTION_SPRINT)
	combat_mode_active = Input.is_action_pressed(ACTION_COMBAT_MODE)


func get_state() -> Dictionary:
	return {
		"raw_input": raw_input,
		"movement_intent_local": movement_intent_local,
		"movement_intent_world": movement_intent_world,
		"reference_forward_world": reference_forward_world,
		"reference_right_world": reference_right_world,
		"has_reference": has_reference,
		"sprint_pressed": sprint_pressed,
		"combat_mode_active": combat_mode_active,
	}


func _read_directional_input() -> void:
	raw_input = Input.get_vector(
		ACTION_MOVE_LEFT,
		ACTION_MOVE_RIGHT,
		ACTION_MOVE_BACKWARD,
		ACTION_MOVE_FORWARD
	)

	var length: float = raw_input.length()
	if length <= input_deadzone:
		raw_input = Vector2.ZERO
	elif length > 1.0:
		raw_input /= length


func _update_reference_axes() -> void:
	if reference_node == null or not is_instance_valid(reference_node):
		has_reference = false
		reference_forward_world = LOCAL_FORWARD
		reference_right_world = LOCAL_RIGHT
		return

	var basis: Basis = reference_node.global_transform.basis

	var forward: Vector3 = basis.z
	if reference_forward_axis == ReferenceForwardAxis.NEGATIVE_Z:
		forward = -forward
	forward.y = 0.0

	var right: Vector3 = basis.x
	right.y = 0.0

	if forward.length_squared() <= AXIS_EPSILON:
		if right.length_squared() <= AXIS_EPSILON:
			forward = LOCAL_FORWARD
			right = LOCAL_RIGHT
		else:
			right = right.normalized()
			if reference_forward_axis == ReferenceForwardAxis.POSITIVE_Z:
				forward = Vector3(-right.z, 0.0, right.x)
			else:
				forward = Vector3(right.z, 0.0, -right.x)
	else:
		forward = forward.normalized()
		if reference_forward_axis == ReferenceForwardAxis.POSITIVE_Z:
			right = Vector3(forward.z, 0.0, -forward.x)
		else:
			right = Vector3(-forward.z, 0.0, forward.x)

	reference_forward_world = forward.normalized()
	reference_right_world = right.normalized()
	has_reference = true


func _clear_state() -> void:
	raw_input = Vector2.ZERO
	movement_intent_local = Vector3.ZERO
	movement_intent_world = Vector3.ZERO
	sprint_pressed = false
	combat_mode_active = false
MotionMatching/movement_intent_validation.gd
extends Node

# Standalone headless validation for the input/movement-intent foundation.
# Creates the controller directly and simulates InputMap actions.

const CONTROLLER_SCRIPT: Script = preload("res://MotionMatching/movement_intent_controller.gd")

const ACTION_MOVE_FORWARD: StringName = &"move_forward"
const ACTION_MOVE_BACKWARD: StringName = &"move_backward"
const ACTION_MOVE_LEFT: StringName = &"move_left"
const ACTION_MOVE_RIGHT: StringName = &"move_right"
const ACTION_SPRINT: StringName = &"sprint"
const ACTION_COMBAT_MODE: StringName = &"combat_mode"

const REQUIRED_ACTIONS: Array[StringName] = [
	ACTION_MOVE_FORWARD,
	ACTION_MOVE_BACKWARD,
	ACTION_MOVE_LEFT,
	ACTION_MOVE_RIGHT,
	ACTION_SPRINT,
	ACTION_COMBAT_MODE,
]

const AIM_POSITIVE_Z: int = 0
const CAMERA_NEGATIVE_Z: int = 1

const EPSILON: float = 0.000001

var _lines: PackedStringArray = PackedStringArray()
var _checks_passed: int = 0
var _checks_failed: int = 0
var _controller = null
var _reference: Node3D = null


func _ready() -> void:
	_line("Godot version: " + str(Engine.get_version_info().get("string", "unknown")))
	_line("================================================================")
	_line("       INPUT / MOVEMENT-INTENT FOUNDATION VALIDATION")
	_line("================================================================")
	_line("Convention: local forward=+Z, backward=-Z, left=-X, right=+X")
	_line("Camera reference uses local -Z forward; aim reference uses local +Z forward.")
	_line("")

	_controller = CONTROLLER_SCRIPT.new()
	_controller.update_in_process = false
	add_child(_controller)
	_controller.set_process(false)

	_reference = Node3D.new()
	add_child(_reference)

	_run_input_map_validation()
	_run_basic_input_validation()
	_run_modifier_validation()
	_run_camera_relative_validation()
	_run_aim_relative_validation()
	_run_separation_validation()

	_release_all_actions()
	_print_summary()
	_flush()
	get_tree().quit()


func _run_input_map_validation() -> void:
	_line("================================================================")
	_line("INPUT MAP ACTIONS")
	_line("================================================================")

	var missing: Array[StringName] = _controller.get_missing_actions()
	_check("all required InputMap actions exist", missing.is_empty(), "missing=" + str(missing))

	for action: StringName in REQUIRED_ACTIONS:
		_check("InputMap has " + str(action), InputMap.has_action(action))

	_line("")


func _run_basic_input_validation() -> void:
	_line("================================================================")
	_line("DIRECTIONAL INPUT AND NORMALIZATION (NO REFERENCE)")
	_line("================================================================")

	_controller.clear_reference()

	_press([])
	_check(
		"no input produces zero local intent",
		_vec_close(_controller.movement_intent_local, Vector3.ZERO),
		"actual=" + _v3(_controller.movement_intent_local)
	)
	_check(
		"no input produces zero world intent",
		_vec_close(_controller.movement_intent_world, Vector3.ZERO),
		"actual=" + _v3(_controller.movement_intent_world)
	)

	var cases: Array = [
		{
			"name": "forward",
			"actions": [ACTION_MOVE_FORWARD],
			"expected": Vector3(0.0, 0.0, 1.0),
		},
		{
			"name": "backward",
			"actions": [ACTION_MOVE_BACKWARD],
			"expected": Vector3(0.0, 0.0, -1.0),
		},
		{
			"name": "left",
			"actions": [ACTION_MOVE_LEFT],
			"expected": Vector3(-1.0, 0.0, 0.0),
		},
		{
			"name": "right",
			"actions": [ACTION_MOVE_RIGHT],
			"expected": Vector3(1.0, 0.0, 0.0),
		},
		{
			"name": "forward-right diagonal",
			"actions": [ACTION_MOVE_FORWARD, ACTION_MOVE_RIGHT],
			"expected": Vector3(1.0, 0.0, 1.0).normalized(),
		},
		{
			"name": "backward-left diagonal",
			"actions": [ACTION_MOVE_BACKWARD, ACTION_MOVE_LEFT],
			"expected": Vector3(-1.0, 0.0, -1.0).normalized(),
		},
		{
			"name": "opposite forward+backward",
			"actions": [ACTION_MOVE_FORWARD, ACTION_MOVE_BACKWARD],
			"expected": Vector3.ZERO,
		},
		{
			"name": "opposite left+right",
			"actions": [ACTION_MOVE_LEFT, ACTION_MOVE_RIGHT],
			"expected": Vector3.ZERO,
		},
	]

	for item in cases:
		var case: Dictionary = item
		var name: String = str(case.get("name", "case"))
		var expected: Vector3 = case.get("expected", Vector3.ZERO)

		_press(case.get("actions", []))

		var local_actual: Vector3 = _controller.movement_intent_local
		var world_actual: Vector3 = _controller.movement_intent_world

		_line(
			"  " + name
			+ " | local=" + _v3(local_actual)
			+ " | world=" + _v3(world_actual)
			+ " | length=" + _f(local_actual.length())
		)

		_check(name + " local intent", _vec_close(local_actual, expected), "expected=" + _v3(expected))
		_check(name + " world intent without reference", _vec_close(world_actual, expected))

		if expected.length() > EPSILON:
			_check(name + " normalized", abs(local_actual.length() - 1.0) <= EPSILON)
		else:
			_check(name + " zero length", local_actual.length() <= EPSILON)

	_line("")


func _run_modifier_validation() -> void:
	_line("================================================================")
	_line("SPRINT AND COMBAT MODE STATE")
	_line("================================================================")

	_press([ACTION_SPRINT])
	_check("sprint action sets sprint state", _controller.sprint_pressed)
	_check("sprint action does not set combat state", not _controller.combat_mode_active)

	_press([ACTION_COMBAT_MODE])
	_check("combat action sets combat state", _controller.combat_mode_active)
	_check("combat action does not set sprint state", not _controller.sprint_pressed)

	_press([ACTION_MOVE_FORWARD, ACTION_SPRINT, ACTION_COMBAT_MODE])
	_check("combined input sets sprint state", _controller.sprint_pressed)
	_check("combined input sets combat state", _controller.combat_mode_active)
	_check(
		"combined input preserves movement intent",
		_vec_close(_controller.movement_intent_local, Vector3(0.0, 0.0, 1.0))
	)

	_line(
		"  state=" + str(_controller.get_state())
	)
	_line("")


func _run_camera_relative_validation() -> void:
	_line("================================================================")
	_line("360-DEGREE CAMERA-RELATIVE MOVEMENT (REFERENCE LOCAL -Z FORWARD)")
	_line("================================================================")

	var yaws: Array = [0.0, 45.0, 90.0, 135.0, 180.0, -135.0, -90.0, -45.0]
	var directions: Array = _eight_directions()

	for yaw_value in yaws:
		var yaw: float = float(yaw_value)
		_set_reference(yaw, CAMERA_NEGATIVE_Z)
		_line("  CAMERA YAW = " + _f(yaw) + " deg")

		for item in directions:
			var direction: Dictionary = item
			var local_expected: Vector3 = direction.get("local", Vector3.ZERO)
			_press(direction.get("actions", []))

			var world_expected: Vector3 = _expected_world_from_reference(local_expected, true)
			var local_actual: Vector3 = _controller.movement_intent_local
			var world_actual: Vector3 = _controller.movement_intent_world

			_line(
				"    " + str(direction.get("name", "direction"))
				+ " | local=" + _v3(local_actual)
				+ " | world=" + _v3(world_actual)
				+ " | expected_world=" + _v3(world_expected)
			)

			_check(
				"camera yaw " + _f(yaw) + " " + str(direction.get("name", "direction")) + " local intent",
				_vec_close(local_actual, local_expected)
			)
			_check(
				"camera yaw " + _f(yaw) + " " + str(direction.get("name", "direction")) + " world intent",
				_vec_close(world_actual, world_expected)
			)
			_check(
				"camera yaw " + _f(yaw) + " " + str(direction.get("name", "direction")) + " unit length",
				abs(world_actual.length() - 1.0) <= EPSILON
			)

		_line("")


