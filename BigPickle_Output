# QUERY BUILDERS
# ============================================================

func _make_straight_query(test_name: String, direction: Vector3) -> Dictionary:
	var unit: Vector3 = direction.normalized()
	var future: Array = []

	for t in FUTURE_TIMES:
		future.append(unit * TEST_SPEED * float(t))

	return {
		"name": test_name,
		"velocity": unit * TEST_SPEED,
		"future": future,
		"api_note": "Straight query: velocity + future positions are directly supported."
	}


func _make_circular_query(test_name: String, omega_deg: float) -> Dictionary:
	var omega: float = deg_to_rad(omega_deg)
	var v_over_omega: float = TEST_SPEED / omega
	var future: Array = []

	for t in FUTURE_TIMES:
		var time: float = float(t)
		future.append(
			Vector3(
				v_over_omega * (1.0 - cos(omega * time)),
				0.0,
				v_over_omega * sin(omega * time)
			)
		)

	return {
		"name": test_name,
		"velocity": Vector3(0.0, 0.0, TEST_SPEED),
		"future": future,
		"omega_deg": omega_deg,
		"api_note": "Circular query: FUTURE POSITIONS ONLY; no desired future yaw deltas are accepted."
	}


func _make_direction_change_query(test_name: String, omega_deg: float) -> Dictionary:
	var omega: float = deg_to_rad(omega_deg)
	var v_over_omega: float = TEST_SPEED / omega
	var future: Array = []

	for t in FUTURE_TIMES:
		var time: float = float(t)
		var elapsed: float = time - TURN_BEGIN_TIME
		var point: Vector3

		if elapsed <= 0.0:
			point = Vector3(0.0, 0.0, TEST_SPEED * time)
		else:
			point = Vector3(
				v_over_omega * (1.0 - cos(omega * elapsed)),
				0.0,
				TEST_SPEED * TURN_BEGIN_TIME + v_over_omega * sin(omega * elapsed)
			)

		future.append(point)

	return {
		"name": test_name,
		"velocity": Vector3(0.0, 0.0, TEST_SPEED),
		"future": future,
		"omega_deg": omega_deg,
		"turn_begin_time": TURN_BEGIN_TIME,
		"api_note": "Direction-change query: piecewise future positions only; initial velocity is straight forward."
	}


