func _print_query_header(
	query: Dictionary,
	category: String,
	continuous: bool,
	state: Dictionary
) -> void:
	_line("")
	_line("================================================================")
	_line("TEST: " + str(query.get("name", "UNNAMED")))
	_line("Category: " + category + (" | continuous" if continuous else " | basic"))
	_line("Desired velocity: " + _v3(query.get("velocity", Vector3.ZERO)))
	_line("Desired future positions:")

	var future: Array = query.get("future", [])
	for i in range(FUTURE_TIMES.size()):
		var time: float = float(FUTURE_TIMES[i])
		var point: Variant = future[i] if i < future.size() else null
		_line("  t=" + _f(time) + " s -> " + _v3(point))

	if query.has("omega_deg"):
		_line("Angular velocity: " + _signed_deg(float(query.get("omega_deg", 0.0))) + " deg/s")

	if query.has("turn_begin_time"):
		_line("Turn begins at t=" + _f(float(query.get("turn_begin_time", 0.0))) + " s")

	if query.has("api_note"):
		_line("API NOTE: " + str(query.get("api_note", "")))

	if continuous:
		_line("Current state: " + str(state.get("label", "N/A")))
		_line("Current animation: " + str(state.get("name", "N/A")))
		_line("Current animation index: " + str(state.get("index", -1)))
		_line("Current animation time: " + _f(float(state.get("time", 0.0))))


