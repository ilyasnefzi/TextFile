func _add_summary_row(
	query: Dictionary,
	category: String,
	result: Dictionary,
	context: Dictionary,
	continuous: bool
) -> void:
	if not bool(result.get("success", false)):
		return

	var ranks: Dictionary = _tracked_ranks(result)
	var row: Dictionary = {
		"category": category,
		"test": str(query.get("name", "UNNAMED")),
		"best": str(result.get("animation_name", "N/A")),
		"class": _classify(str(result.get("animation_name", ""))),
		"r189": int(ranks.get("R_189", -1)),
		"l190": int(ranks.get("L_190", -1)),
		"yaw": _float_array(result.get("future_yaw_deltas_degrees", [])),
		"rotation": _f(result.get("rotation_cost", -1.0)),
		"total": _f(result.get("cost", -1.0))
	}

	if continuous:
		row["current"] = str(context.get("current_label", "N/A"))
		row["changed"] = str(context.get("changed", "N/A"))
		row["base"] = _f(result.get("base_cost", -1.0))
		row["continuity"] = _f(result.get("continuity_cost", -1.0))
		row["selection"] = _f(result.get("selection_score", -1.0))

	_summary_rows.append(row)


