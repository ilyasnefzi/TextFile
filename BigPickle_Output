func _run_separation_validation() -> void:
	_line("================================================================")
	_line("SEPARATION FROM PHYSICS, PLAYBACK, AND SEARCH")
	_line("================================================================")

	var source: String = str(_controller.get_script().get_source_code())

	var has_forbidden_property: bool = false
	for property_item in _controller.get_property_list():
		var property: Dictionary = property_item
		if str(property.get("name", "")) == "velocity":
			has_forbidden_property = true

	_check("controller is not a CharacterBody3D", not (_controller is CharacterBody3D))
	_check("controller has no velocity property", not has_forbidden_property)
	_check(
		"controller source has no physics body type",
		not source.contains("CharacterBody3D")
	)
	_check(
		"controller source has no search integration",
		not source.contains("MotionMatchingSearch") and not source.contains("search_best")
	)
	_check(
		"controller source has no playback integration",
		not source.contains("AnimationPlayer")
		and not source.contains("AnimationTree")
		and not source.contains("root_motion")
	)
	_line("")


