func _print_top_matches(result: Dictionary, continuous: bool) -> void:
	_line("")
	_line("TOP " + str(TOP_MATCHES_TO_PRINT) + " CANDIDATES")

	var top: Variant = result.get("top_matches", [])
	if typeof(top) != TYPE_ARRAY:
		_line("top_matches field missing or not an Array.")
		return

	var top_array: Array = top
	if top_array.is_empty():
		_line("No top matches returned.")
		return

	var count: int = mini(TOP_MATCHES_TO_PRINT, top_array.size())

	for i in range(count):
