func _set_reference(yaw_degrees: float, axis: int) -> void:
	_reference.rotation.y = deg_to_rad(yaw_degrees)
	_reference.force_update_transform()
	_controller.set_reference(_reference, axis)


func _expected_world_from_reference(local: Vector3, camera_axis: bool) -> Vector3:
	var basis: Basis = _reference.global_transform.basis

	var forward: Vector3 = basis.z
	if camera_axis:
		forward = -forward
	forward.y = 0.0
	forward = forward.normalized()

	var right: Vector3 = basis.x
	right.y = 0.0
	right = right.normalized()

	return right * local.x + forward * local.z


func _press(actions: Array) -> void:
	_release_all_actions()
	for action in actions:
		Input.action_press(action)
	_controller.update_movement_intent()


func _release_all_actions() -> void:
	for action: StringName in REQUIRED_ACTIONS:
		Input.action_release(action)


func _vec_close(a: Vector3, b: Vector3) -> bool:
	return a.distance_to(b) <= EPSILON


func _check(name: String, passed: bool, detail: String = "") -> void:
	if passed:
		_checks_passed += 1
	else:
		_checks_failed += 1

	var line: String = "  CHECK " + name + ": " + ("PASS" if passed else "FAIL")
	if detail != "":
		line += " | " + detail
	_line(line)


func _print_summary() -> void:
	_line("================================================================")
	_line("VALIDATION SUMMARY")
	_line("================================================================")
	_line("  checks passed=" + str(_checks_passed))
	_line("  checks failed=" + str(_checks_failed))
	_line("  result=" + ("PASS" if _checks_failed == 0 else "FAIL"))


func _f(value: float) -> String:
	return "%0.6f" % value


func _v3(value: Vector3) -> String:
	return (
		"(" + _f(value.x) + ", " + _f(value.y) + ", " + _f(value.z) + ")"
	)


func _line(text: String) -> void:
	_lines.append(text)


func _flush() -> void:
	var output_file: FileAccess = FileAccess.open(
		"user://movement_intent_validation_output.txt", FileAccess.WRITE
	)
	if output_file != null:
		for line in _lines:
			output_file.store_line(line)
		output_file.close()

	for line in _lines:
		print(line)
